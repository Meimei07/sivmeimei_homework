<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
   xmlns:app="http://schemas.android.com/apk/res-auto"
   xmlns:tools="http://schemas.android.com/tools"
   android:id="@+id/main"
   android:layout_width="match_parent"
   android:layout_height="match_parent"
   tools:context=".MainActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
    >
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/rootLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginVertical="25dp"
        >
            <!-- Logo -->
            <ImageView
                android:id="@+id/logo"
                android:layout_width="75dp"
                android:layout_height="75dp"
                android:src="@drawable/logo"
                android:contentDescription="logo"
                android:background="@drawable/logo_round"
                android:clipToOutline="true"

                app:layout_constraintTop_toTopOf="@id/main"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
            />

            <!--  Title  -->
            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title"
                android:textSize="25sp"
                android:layout_marginVertical="15dp"

                app:layout_constraintTop_toBottomOf="@id/logo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
            />

            <!--  Subtitle  -->
            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/subtitle"
                android:textSize="30sp"
                android:layout_marginVertical="20dp"

                app:layout_constraintTop_toBottomOf="@id/title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
            />

            <!-- Username -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/etUsernameLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/username_input"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="20dp"
                app:startIconDrawable="@drawable/username_24"
                app:startIconTint="@color/primary"
                app:hintTextColor="@color/primary"
                app:boxStrokeColor="@color/primary"

                app:layout_constraintTop_toBottomOf="@id/subtitle"
            >
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/etPasswordLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/password_input"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="10dp"
                app:startIconDrawable="@drawable/password_24"
                app:endIconMode="password_toggle"
                app:startIconTint="@color/primary"
                app:hintTextColor="@color/primary"
                app:boxStrokeColor="@color/primary"

                app:layout_constraintTop_toBottomOf="@id/etUsernameLayout"
            >
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Login btn -->
            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login"
                android:textSize="16sp"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_state_toggle"
                app:backgroundTint="@null"
                android:enabled="false"

                app:layout_constraintTop_toBottomOf="@id/etPasswordLayout"
            />

            <!-- Forgot password btn -->
            <Button
                android:id="@+id/btnForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forgot_password"
                android:textSize="16sp"
                android:layout_marginTop="-10dp"
                android:textColor="@color/primary"
                android:background="@android:color/transparent"

                app:layout_constraintTop_toBottomOf="@id/btnLogin"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
            />

            <!-- Or login with -->
            <LinearLayout
                android:id="@+id/orLoginWithContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginHorizontal="15dp"
                android:layout_marginVertical="10dp"

                app:layout_constraintTop_toBottomOf="@id/btnForgotPassword"
            >
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@android:color/darker_gray"
                />

                <TextView
                    android:id="@+id/tvOrLoginWith"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/or_login_with"
                    android:textSize="16sp"
                    android:paddingHorizontal="15dp"

                    app:layout_constraintTop_toBottomOf="@id/btnForgotPassword"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@android:color/darker_gray"
                />
            </LinearLayout>

            <!-- Other login options -->
            <LinearLayout
                android:id="@+id/otherOptionsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="15dp"

                app:layout_constraintTop_toBottomOf="@id/orLoginWithContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
            >
                <!-- Google -->
                <ImageView
                    android:id="@+id/btnGoogle"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/google"
                    android:background="@drawable/rounded_border"
                    app:backgroundTint="@null"
                    android:padding="10dp"
                    android:layout_marginHorizontal="10dp"
                />

                <!-- Facebook -->
                <ImageView
                    android:id="@+id/btnFacebook"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/facebook"
                    android:background="@drawable/rounded_border"
                    app:backgroundTint="@null"
                    android:padding="10dp"
                    android:layout_marginHorizontal="10dp"
                />

                <!-- Github -->
                <ImageView
                    android:id="@+id/btnGithub"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/github"
                    android:background="@drawable/rounded_border"
                    app:backgroundTint="@null"
                    android:padding="10dp"
                    android:layout_marginHorizontal="10dp"
                />
            </LinearLayout>

            <!-- Sign up -->
            <Button
                android:id="@+id/btnSignUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:layout_marginVertical="20dp"
                android:background="@android:color/transparent"
                android:textColor="@color/cardview_dark_background"

                app:layout_constraintTop_toBottomOf="@id/otherOptionsContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
            />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>